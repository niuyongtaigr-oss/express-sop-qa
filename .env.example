# 快递 SOP 智能问答系统 — 配置示例
# 复制为 .env 后按需修改；所有配置项也可直接通过同名环境变量注入（前缀 SOP_QA_）
# 本文件不包含任何真实密钥，请勿把真实密钥提交到仓库

# ── 应用 ──────────────────────────────────────────────
SOP_QA_LOG_LEVEL=INFO
# dev | prod。**prod 下未配置访问控制会拒绝启动**(fail-closed), 否则照本文档
# 起容器就会得到一台无鉴权的公网服务。
#
# 这里默认 prod —— 复制本文件即得到安全默认值。**本地直接跑 uvicorn 请改成 dev**
# (或启动时加 SOP_QA_ENV=dev), 见 README「本地启动」。
SOP_QA_ENV=prod

# ── Ollama / 模型 ──────────────────────────────────────
SOP_QA_OLLAMA_BASE_URL=http://localhost:11434
SOP_QA_LLM_MODEL=qwen2.5:7b
SOP_QA_EMBED_MODEL=bge-m3
# LLM 单次调用超时 (秒)。**必须小于 chat_timeout_s (默认 60)**:
# 外层 asyncio.wait_for 取消的是协程, to_thread 里的线程不可取消 ——
# 只有 LLM 自己先超时, 线程才会结束, 并发上限才有效。
SOP_QA_LLM_TIMEOUT_S=50

# ── 多模型路由 (P3-C) ───────────────────────────────────
# provider: ollama | openai (OpenAI 兼容协议, 通义/DeepSeek/vLLM 均可用)
SOP_QA_LLM_PROVIDER=ollama
# 意图识别专用模型 (如 qwen2.5:3b; 不配置则与回答共用 llm_model)
# SOP_QA_INTENT_MODEL=qwen2.5:3b
# OpenAI 兼容服务的连接配置 (provider=openai 时生效)
# SOP_QA_OPENAI_BASE_URL=https://api.deepseek.com/v1
# SOP_QA_OPENAI_API_KEY=sk-xxx
# SOP_QA_OPENAI_MODEL=deepseek-chat

# ── 知识库 ─────────────────────────────────────────────
SOP_QA_SOP_PATH=data/sop.txt
SOP_QA_SOP_DOC_ID=sop
# 语料目录: 真实行业资料 (法规/规范/制度), 每篇导入为一个独立文档
SOP_QA_CORPUS_DIR=data/corpus
SOP_QA_CHROMA_DIR=data/chroma
SOP_QA_COLLECTION_NAME=sop_knowledge
SOP_QA_CHUNK_SIZE=200
SOP_QA_CHUNK_OVERLAP=40
SOP_QA_TOP_K=3
# 检索模式: hybrid=向量+BM25 融合(RRF) / vector=纯向量 / bm25=纯BM25(评测对照)
SOP_QA_RETRIEVAL_MODE=hybrid

# ── 重排 (粗排之后的精排, 默认关闭) ─────────────────────
# 开启后每次查询多一次 LLM 调用。实测增益见 README「检索效果实测」。
SOP_QA_RERANK_ENABLED=false
SOP_QA_RERANK_CANDIDATES=12     # 参与重排的候选数 (粗排多取, 精排后截到 top_k)
SOP_QA_RERANK_MAX_CHARS=300     # 每个候选送入重排的字符上限 (控上下文)

# ── 文档解析 (上传 PDF/Word/Excel 入库) ─────────────────
SOP_QA_DOC_MAX_BYTES=20971520      # 单文件体积上限 (字节), 默认 20 MB
SOP_QA_DOC_MAX_CHARS=2000000       # 单文档抽取字符上限 (超出截断), 默认 200 万

# ── 多轮会话 (记忆) ─────────────────────────────────────
SOP_QA_SESSION_TTL_S=1800          # 会话空闲过期秒数
SOP_QA_SESSION_MAX_TURNS=10        # 单会话保留最大轮数
SOP_QA_SESSION_MAX_SESSIONS=2000   # 内存会话上限 (LRU)
SOP_QA_SESSION_SWEEP_INTERVAL_S=60 # 后台清理间隔秒数

# ── 编排 ───────────────────────────────────────────────
SOP_QA_MULTI_HOP_MAX_ROUNDS=2
SOP_QA_MULTI_HOP_SIMILARITY_THRESHOLD=0.6

# ── 评测 (P2) ───────────────────────────────────────────
SOP_QA_EVAL_CASES_PATH=data/eval_cases.json  # 结构化评测集 (不存在则用内置)
SOP_QA_EVAL_JUDGE=true                        # LLM-as-Judge 答案质量评分开关
SOP_QA_EVAL_HISTORY_PATH=data/eval_history.jsonl  # 评测历史 (回归对比)

# ── 用户反馈 (P2) ───────────────────────────────────────
SOP_QA_FEEDBACK_PATH=data/feedback.jsonl      # 用户反馈落盘 (按租户隔离, 统计只返回本租户)

# CORS: 逗号分隔的来源清单, 留空 = 不挂 CORS 中间件 (同源部署不需要)。
# 本服务用 X-API-Key 请求头鉴权, 不使用 Cookie, 因此没有 allow_credentials 开关。
# 例: SOP_QA_CORS_ALLOW_ORIGINS=https://admin.example.com,https://ops.example.com
# 注意本行必须**真的为空** —— 写成 `SOP_QA_CORS_ALLOW_ORIGINS=  # 例: ...` 时,
# dotenv 不会剥离行内注释, 解析出来是 "# 例: ..." 这个非空字符串, 于是 CORS 中间件
# 会被挂上, 而文档承诺的是"留空即关闭"。
SOP_QA_CORS_ALLOW_ORIGINS=

# ── 生产化（限流/超时） ────────────────────────────────
SOP_QA_MAX_CONCURRENCY=4
SOP_QA_CHAT_TIMEOUT_S=60.0
SOP_QA_RAG_TIMEOUT_S=30.0

# ── 答案缓存 (P3) ───────────────────────────────────────
SOP_QA_CACHE_ENABLED=true          # 无会话相同问题的短 TTL 答案缓存
SOP_QA_CACHE_TTL_S=300             # 缓存过期秒数
SOP_QA_CACHE_MAX_ENTRIES=512       # 缓存条目上限 (LRU)

# ── 细粒度限流/配额 (P3-D) ──────────────────────────────
SOP_QA_RATE_LIMIT_ENABLED=false    # 按 Key/IP 限流总开关 (生产开启)
SOP_QA_RATE_LIMIT_PER_MIN=60       # 每 Key 每分钟请求上限 (必须 >=1; 为 0 令牌永不补充且会除零)
SOP_QA_RATE_LIMIT_BURST=20         # 令牌桶突发上限
SOP_QA_RATE_QUOTA_DAILY=1000       # 每 Key 每日配额 (跨天重置)
SOP_QA_RATE_LIMIT_MAX_KEYS=10000   # 限流器内存上界 (令牌桶数; 当日记账表 = 4 倍, 必须 >=1)

# ── 安全 ───────────────────────────────────────────────
# 配置后, 除 /api/v1/health 与 /metrics 外的业务接口必须携带 X-API-Key 头。
# 生成方式: openssl rand -hex 24
#
# 不配置会怎样, 取决于 SOP_QA_ENV:
#   dev  → 放行 + 日志告警 (仅限本地开发)
#   prod → **拒绝启动** (fail-closed)。裸奔的服务不该靠一行 warning 提示,
#          因为没人会看见 —— 而它承载的是企业内部知识库。
# 当前访问控制状态可从 GET /api/v1/health 的 auth 字段看到:
#   enabled(已启用) / tenant(多租户) / disabled(未启用)
# SOP_QA_API_KEY=

# ── 多租户 (P4) ─────────────────────────────────────────
# 开启后 X-API-Key 映射到租户 (data/tenants.json), 检索/文档按租户隔离;
# 默认 SOP 进共享库 (shared), 所有租户可检索
SOP_QA_TENANT_MODE=false
SOP_QA_TENANTS_PATH=data/tenants.json
SOP_QA_SHARED_TENANT_ID=shared

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境
venv/
.venv/

# 环境变量（含密钥，绝不提交）
.env

# 运行时产物（Chroma 持久化索引）
data/chroma/

# 运行时产物（评测历史 / 用户反馈）
data/eval_history.jsonl
data/feedback.jsonl

# IDE / OS
.idea/
.vscode/
.DS_Store

# 本地 AI 助手的个人配置 (可能含本机路径/权限清单)。
# 本机已由全局 gitignore 兜住, 但全局配置不跟着仓库走 —— 换台机器 clone 后
# `git add -A` 就会把它提交进去, 所以这里再写一遍。
.claude/settings.local.json

# 本地构建临时产物 (wheels/离线构建)
.build/

# 隐私自检的本地敏感词表 (绝不提交 —— 它装的就是不能进仓库的东西)
# 规则见 scripts/check_privacy.py
.privacy-terms
